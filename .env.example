# Live-mode API server (server/index.mjs). Copy to .env and set real values; never commit .env.
# Required
AUTH_SECRET=                 # at least 32 random characters, e.g. `openssl rand -base64 48`
# Storage: PostgreSQL in production; without DATABASE_URL the server keeps data in memory (development only)
DATABASE_URL=                # postgres://user:password@host:5432/con
DATABASE_SSL=1               # 1 to require TLS to the database
DATA_FILE=                   # optional JSON file for the in-memory store (development only)
PRIVATE_STORAGE_DIR=         # directory outside the public site for licence documents (mode 700)
# Network
HOST=127.0.0.1
PORT=8787
TRUST_PROXY=0                # 1 only behind a trusted reverse proxy that sets X-Forwarded-For
HSTS=0                       # 1 when served over HTTPS
TOKEN_TTL=28800              # seconds
LOGIN_RATE_LIMIT=10          # attempts per 15 minutes per IP and email
REGISTER_RATE_LIMIT=20       # registrations per hour per IP
# First operations account (created once, then remove the password)
OPS_BOOTSTRAP_EMAIL=
OPS_BOOTSTRAP_PASSWORD=
# Providers — leave empty until contracts and credentials exist; the related actions return 503 "not configured"
PAYMENT_PROVIDER=            # name of the integrated provider adapter
PAYMENT_WEBHOOK_SECRET=      # shared secret for signed payment events (X-CON-Signature)
PAYOUT_PROVIDER=
NOTIFICATIONS_PROVIDER=
CLAMAV_HOST=                 # clamd host for malware scanning of uploaded documents
CLAMAV_PORT=3310
